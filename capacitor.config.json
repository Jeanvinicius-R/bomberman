{
  "appId": "br.com.bombastico.app",
  "appName": "Bombástico",
  "webDir": "dist",
  "loggingBehavior": "debug",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
